{% extends 'layout/base.twig' %}

{% block title %}{{ trans('shop.checkout.title') }} – {{ site_name }}{% endblock %}

{% block content %}
<h1>{{ trans('shop.checkout.title') }}</h1>

<ul>
    {% for item in items %}
        <li>{{ item.quantity }} × {{ item.title }} — {{ item.label }} ({{ money(item.line_total, currency) }})</li>
    {% endfor %}
</ul>
<p>
    {{ trans('shop.checkout.subtotal') }}: {{ money(subtotal, currency) }}<br>
    {% if discount_code %}
        {{ trans('shop.discount.applied_as', {code: discount_code, amount: money(discount_amount, currency)}) }}<br>
        {% if discount_problem %}<small>{{ discount_problem }}</small><br>{% endif %}
    {% endif %}
    {{ trans('shop.checkout.shipping') }}: {{ money(shipping, currency) }}<br>
    <strong>{{ trans('shop.checkout.total') }}: {{ money(total, currency) }}</strong>
</p>

{% for error in errors %}
    <p class="flash flash-error" role="alert">{{ error }}</p>
{% endfor %}

{% if methods is empty %}
    <p class="flash flash-error">{{ trans('core.order.error.no_payment_method') }}</p>
{% else %}
    <form method="post" action="{{ url('/checkout') }}" class="stack-form">
        {{ csrf_field() }}
        <fieldset>
            <legend>{{ trans('core.order.payment') }}</legend>
            {% for method in methods %}
                <label class="checkbox">
                    <input type="radio" name="payment_method" value="{{ method.id }}" {{ method.id == payment_method or (payment_method is null and loop.first) ? 'checked' }} required>
                    <span>{{ trans(method.label_key) }}</span>
                </label>
            {% endfor %}
        </fieldset>
        {% if terms %}
            <label class="checkbox">
                <input type="checkbox" name="accept_terms" value="1" required>
                <span>{{ trans('core.register.accept') }} <a href="{{ url(terms.path) }}" target="_blank" rel="noopener">{{ terms.title }}</a></span>
            </label>
        {% endif %}
        <button type="submit">{{ trans('shop.checkout.submit') }}</button>
    </form>
{% endif %}
{% endblock %}
